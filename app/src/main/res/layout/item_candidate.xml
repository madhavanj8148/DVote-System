<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.DVoteSystem.CardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivCandidatePhoto"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_report_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            android:contentDescription="Candidate Photo" />

        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Candidate Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/onSurface"
            app:layout_constraintTop_toTopOf="@id/ivCandidatePhoto"
            app:layout_constraintStart_toEndOf="@id/ivCandidatePhoto"
            app:layout_constraintEnd_toStartOf="@id/ivPartySymbol" />

        <TextView
            android:id="@+id/tvPartyName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Party Name"
            android:textSize="14sp"
            android:textColor="@color/onSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            app:layout_constraintStart_toStartOf="@id/tvCandidateName"
            app:layout_constraintEnd_toStartOf="@id/ivPartySymbol" />

        <ImageView
            android:id="@+id/ivPartySymbol"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_gallery"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="Party Symbol" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>